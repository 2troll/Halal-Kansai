<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget de pantalla de inicio: vive en el lanzador, fuera de la app. -->
        <receiver
            android:name=".PrayerWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_widget_info" />
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Leer el codigo de barras del envase. Sin esto el escaner falla al
         abrirse, no al instalarse: es el fallo que solo se ve en el konbini. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Escuchar la jutba. Lo declara tambien el plugin de voz y el
         fusionador lo arrastraria, pero el permiso de la funcion principal no
         puede depender del manifest de una dependencia: si manana se cambia de
         plugin, el microfono deja de pedirse y solo se descubre un viernes.
         El audio se procesa en el aparato y no se graba ni se sube. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Sin esto el WebView NO recibe el micrófono aunque RECORD_AUDIO esté
         concedido: Capacitor (BridgeWebChromeClient.onPermissionRequest) pide
         los dos y, si falta uno en el manifest, deniega getUserMedia. Eso
         dejaba muertos el modo «En este teléfono» (Whisper) y el medidor de
         nivel en Android. Es un permiso normal: no se le pregunta a nadie. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Horas de rezo y qibla del sitio donde estas. La ubicacion no sale
         del telefono: el calculo es local. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
