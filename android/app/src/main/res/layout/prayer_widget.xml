<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de próximo rezo.

  Sin adornos a propósito: se mira de reojo, en una pantalla llena de otros
  iconos y a veces al sol. Nombre, hora grande y ciudad. Nada más.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E0C684"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_empty" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F6F1E6"
        android:textSize="30sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:text="—" />

    <TextView
        android:id="@+id/widget_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9DB3AA"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
