{
  "name": "halal-kansai",
  "version": "0.1.0",
  "description": "Herramienta diaria gratuita para la comunidad musulmana en Japón: salat, qibla, lugares halal y traducción de la jutba en vivo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests tools server",
    "icons": "node tools/gen-icons.mjs",
    "dev:server": "node --experimental-strip-types server/src/node.ts",
    "build:quran": "node tools/build-quran-data.mjs",
    "start": "bash scripts/start.sh",
    "build:worker": "npm run build && rm -rf dist/data && cp -R server/data dist/data && rm -f dist/data/suggestions.json",
    "deploy": "npm run build:worker && npx wrangler deploy",
    "app:build": "npm run build && rm -rf dist/data && npx cap sync",
    "app:android": "npm run app:build && npx cap open android",
    "app:ios": "npm run app:build && npx cap open ios"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:35673/git/2troll/Halal-Kansai"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@capacitor-mlkit/barcode-scanning": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.12.25",
    "leaflet": "^1.9.4"
  },
  "type": "module",
  "private": true
}
